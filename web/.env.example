# Service OpenFisca-France (couche nationale exacte). Optionnel en dev :
# sans lui, l'app utilise ses estimations locales.
OPENFISCA_URL=http://localhost:5000

# Aides et services locaux (data.inclusion). Clé gratuite sur demande :
# https://data.inclusion.beta.gouv.fr  (sans clé, les aides locales ne s'affichent pas)
DATA_INCLUSION_API_KEY=

